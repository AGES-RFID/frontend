{
  "name": "front",
  "module": "index.ts",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --hot public/index.html",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "bun run typecheck && bun run lint && bun run format",
    "check:fix": "bun run typecheck && bun run lint --write --unsafe && bun run format --write && git update-index --again",
    "test": "bun test",
    "test:cov": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@types/d3": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "d3": "^7.9.0",
    "ky": "^2.0.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.18.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  }
}
